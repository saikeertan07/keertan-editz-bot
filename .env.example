# Server & Dashboard Settings
SERVER_PORT=5001
HOST=127.0.0.1
DEBUG=False

# Automation & Worker Profile
BROWSER_HEADLESS=True
PROFILE_NAME=default_operator

# Media Processing Defaults
AUTO_WATERMARK_REMOVAL=True
APPLY_BRAND_OVERLAY=True
OUTPUT_DIR=./Output
